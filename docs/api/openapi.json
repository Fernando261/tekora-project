          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "description": "Reutiliza ProviderAvailability::publicFor. No representa slots reservables ni revela reservas, motivos de bloqueo, revisiones o identidades. Fechas civiles y horas locales se interpretan con la zona IANA. No convertir una recurrencia semanal con un offset UTC fijo. Sin configuración: timezone=null e intervalos/fechas vacíos."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco de Sanctum; guardar en almacenamiento seguro del dispositivo. Nunca en URL o logs."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "fields"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "Client": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "experience",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "experience": {
            "type": "string",
            "enum": [
              "client"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "client.appointments.view",
                "client.inquiries.manage"
              ]
            }
          }
        }
      },
      "Provider": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "headline",
          "bio"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "display_name": {
            "type": "string"
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "slug"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Service": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "modality",
          "category",
          "provider"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "modality": {
            "type": "string",
            "enum": [
              "remote",
              "onsite",
              "both"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_page",
          "per_page",
          "last_page",
          "total"
        ],
        "properties": {
          "current_page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "last_page": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Availability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_id",
          "configured",
          "timezone",
          "kind",
          "intervals",
          "blocked_dates",
          "queried_at"
        ],
        "properties": {
          "service_id": {
            "type": "integer",
            "minimum": 1
          },
          "configured": {
            "type": "boolean"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Zona IANA del prestador. Null si no hay configuración."
          },
          "kind": {
            "type": "string",
            "enum": [
              "informational_weekly_schedule"
            ]
          },
          "intervals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weekday",
                "start_local",
                "end_local"
              ],
              "properties": {
                "weekday": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7,
                  "description": "ISO: lunes=1, domingo=7"
                },
                "start_local": {
                  "type": "string",
                  "pattern": "^[0-2][0-9]:[0-5][0-9]$"
                },
                "end_local": {
                  "type": "string",
                  "pattern": "^[0-2][0-9]:[0-5][0-9]$",
                  "description": "Puede ser 24:00: medianoche al final del día."
                }
              }
            }
          },
          "blocked_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          },
          "queried_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "device_name"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "device_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Identificador descriptivo estable por dispositivo. Sin controles ni < >."
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token_type",
          "access_token",
          "expires_at",
          "user"
        ],
        "properties": {
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/Client"
          }
        }
      },
      "Logout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revoked"
        ],
        "properties": {
          "revoked": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "La petición no es válida.",
        "content": {
          "application/json": {
            "schema": {
