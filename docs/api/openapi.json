{
  "openapi": "3.1.0",
  "info": {
    "title": "Tekora API móvil",
    "version": "1.0.0",
    "description": "Etapa 9B. JSON UTF-8 incluso sin Accept. Todas las respuestas usan Cache-Control: no-store, private y X-Content-Type-Options: nosniff. Solo Bearer real para endpoints privados; las cookies web no lo sustituyen. Se revalidan rol y permisos actuales de solicitante. Las cuentas duales obtienen solo experiencia client. Los parámetros adicionales se rechazan con 422 en login y consultas públicas. Orden de servicios: id descendente; perfiles: display_name, id ascendente. Las páginas fuera del total devuelven data vacío. El texto es texto plano; el cliente no debe interpretarlo como HTML. 409 se reserva para futuros workflows de escritura de 9C; 9B no añade esas operaciones.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8013/api/v1",
      "description": "Clon local aislado; en servidores reales usar HTTPS"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Emitir token móvil de solicitante",
        "security": [],
        "responses": {
          "201": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Login"
                    }
                  }
                },
                "example": {
                  "data": {
                    "token_type": "Bearer",
                    "access_token": "<token devuelto una sola vez>",
                    "expires_at": "2030-02-01T18:00:00.000000Z",
                    "user": {
                      "id": 4,
                      "name": "Solicitante de prueba",
                      "email": "cliente@example.test",
                      "experience": "client",
                      "permissions": [
                        "client.appointments.view",
                        "client.inquiries.manage"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Mismo error para cuenta inexistente, contraseña incorrecta y rol/permisos insuficientes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_credentials",
                    "message": "No se pudo iniciar sesión con los datos proporcionados.",
                    "fields": {}
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              },
              "example": {
                "email": "cliente@example.test",
                "password": "<contraseña existente>",
                "device_name": "Expo Android de prueba"
              }
            }
          }
        },
        "description": "5 intentos/minuto por correo normalizado e IP; 20/minuto por IP. Token de 30 días, ability client:read. Reemplaza el token del mismo device_name. Máximo 5 tokens móviles por usuario; elimina primero el más antiguo. No inicia sesión web. No hay refresh token."
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revocar únicamente el token actual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Logout"
                    }
                  }
                },
                "example": {
                  "data": {
                    "revoked": true
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "me",
        "summary": "Consultar identidad propia en experiencia solicitante",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Client"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 4,
                    "name": "Solicitante de prueba",
                    "email": "cliente@example.test",
                    "experience": "client",
                    "permissions": [
                      "client.appointments.view",
                      "client.inquiries.manage"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/services": {
      "get": {
        "operationId": "services",
        "summary": "Listar servicios públicos",
        "security": [],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Service"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Page"
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 21,
                      "title": "Soporte de computadoras",
                      "description": "Diagnóstico remoto.",
                      "modality": "remote",
                      "category": {
                        "id": 1,
                        "name": "Soporte técnico",
                        "slug": "soporte-tecnico"
                      },
                      "provider": {
                        "id": 7,
                        "display_name": "Soporte local",
                        "headline": "Especialista en equipos",
                        "bio": "Diagnóstico y mantenimiento."
                      }
                    }
                  ],
                  "meta": {
                    "current_page": 1,
                    "per_page": 12,
                    "last_page": 1,
                    "total": 1
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "description": "Slug de categoría activa."
            }
          },
          {
            "name": "modality",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "remote",
                "onsite",
                "both"
              ],
              "description": "remote/onsite también incluyen servicios both."
            }
          }
        ]
      }
    },
