    "/services/{service}/availability": {
      "get": {
        "operationId": "serviceAvailability",
        "summary": "Consultar horario público informativo",
        "security": [],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Availability"
                    }
                  }
                },
                "example": {
                  "data": {
                    "service_id": 21,
                    "configured": true,
                    "timezone": "America/Mexico_City",
                    "kind": "informational_weekly_schedule",
                    "intervals": [
                      {
                        "weekday": 1,
                        "start_local": "09:00",
                        "end_local": "12:00"
                      }
                    ],
                    "blocked_dates": [
                      "2030-01-01"
                    ],
                    "queried_at": "2029-12-01T18:00:00.000000Z"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
