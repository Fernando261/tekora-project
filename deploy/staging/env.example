# TEMPLATE ONLY. Do not copy without reviewing paths, domain and secrets.
# Isolated HTTPS staging; Laravel runs in production mode to keep demo checkout disabled.
APP_NAME=Tekora-Staging
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://staging.example.invalid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_URL=
DB_DATABASE=/srv/tekora-staging/shared/database/staging.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=tekora_staging_session
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Fail safely: configure a dedicated, controlled SMTP sink before identity tests.
# Never deliver synthetic registration/recovery messages to actual customers.
MAIL_MAILER=smtp
MAIL_HOST=mail.example.invalid
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=staging@example.invalid
MAIL_FROM_NAME="Tekora Staging"

# Never enable the isolated local checkout here.
TEKORA_CHECKOUT_DEMO_ROOT=
